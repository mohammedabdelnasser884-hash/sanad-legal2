{
  "name": "sanad-legal-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:analyze": "ANALYZE=true npm run build",
    "test:visual": "playwright test e2e/mobile/visual-regression.spec.ts --project=mobile",
    "test:visual:update": "playwright test e2e/mobile/visual-regression.spec.ts --project=mobile --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "jspdf": "^4.2.1",
    "html2canvas": "^1.4.1",
    "docx": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "@playwright/test": "^1.48.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.0",
    "storybook": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "eslint-plugin-storybook": "^10.5.10"
  }
}
